# Copy to .env and set local paths and credentials.
HUB_KUBECONFIG="${HOME}/.kube/hub-kubeconfig"
SPOKE_KUBECONFIG="${HOME}/.kube/spoke-kubeconfig"

# Supply this through the environment, never commit its value.
ONLY_OLS_OPENAI_API_KEY="${ONLY_OLS_OPENAI_API_KEY:-}"

# Set true only when building all three controller images before setup.
WITH_IMAGES="false"

# Set true only when installing stage 01 with PostgreSQL support.
WITH_POSTGRES="false"

# Stage 00 defaults every controller to its upstream main branch.
# Uncomment individual overrides to build a fork branch or PR instead.
# AGENTIC_OPERATOR_SOURCE_URL="https://github.com/openshift/lightspeed-agentic-operator.git"
# AGENTIC_OPERATOR_SOURCE_REF="main"
# HUB_SOURCE_URL="https://github.com/openshift/lightspeed-hub.git"
# HUB_SOURCE_REF="main"
# AAA_SOURCE_URL="https://github.com/openshift/lightspeed-agentic-alerts-adapter.git"
# AAA_SOURCE_REF="main"